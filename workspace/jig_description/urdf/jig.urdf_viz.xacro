<?xml version="1.0"?>
<robot name="jig">

  <!-- BASE (Jetson Orin Nano) -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.15 0.02"/>
      </geometry>
      <material name="green">
        <color rgba="0.0 0.6 0.0 1.0"/>
      </material>
    </visual>
  </link>

  <!-- IMU LINK (Spresense) -->
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.01"/>
      </geometry>
      <material name="blue">
        <color rgba="0.0 0.0 0.8 1.0"/>
      </material>
    </visual>
  </link>

  <!-- LIDAR LINK (MID360) -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.038" length="0.04"/>
      </geometry>
      <material name="red">
        <color rgba="0.8 0.0 0.0 1.0"/>
      </material>
    </visual>
  </link>

  <!-- BASE to IMU -->
  <joint name="base_to_imu" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.04 -0.12 0.01" rpy="0 0 0"/>
  </joint>

  <!-- BASE to LIDAR -->
  <joint name="base_to_lidar" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="-0.00 -0.12 0.005" rpy="0 0 0"/>
  </joint>

</robot>









